APP_NAME=Live Stream Monitor API
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql+asyncpg://live_stream:live_stream@localhost:5432/live_stream
DATABASE_ECHO=false
MEDIA_RTMP_URL=rtmp://localhost:1935
MEDIA_HLS_URL=http://localhost:8888
MEDIA_WEBRTC_URL=http://localhost:8889
