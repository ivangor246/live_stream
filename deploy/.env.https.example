# Use a DNS name without a protocol or path.
LIVE_STREAM_DOMAIN=stream.example.com
CADDY_EMAIL=admin@example.com

# Replace both values before exposing the installation.
POSTGRES_PASSWORD=replace-with-a-long-unique-password
MEDIA_AUTH_SECRET=replace-with-a-long-random-secret

# Publish browser media through the same HTTPS origin.
CORS_ORIGINS=https://stream.example.com
AUTH_SECURE_COOKIE=true
MEDIA_RTMP_URL=rtmp://stream.example.com:1935
MEDIA_HLS_URL=https://stream.example.com/hls
MEDIA_WEBRTC_URL=https://stream.example.com/webrtc

# Keep internal services on loopback; Caddy is the public HTTP entry point.
POSTGRES_BIND_ADDRESS=127.0.0.1
BACKEND_BIND_ADDRESS=127.0.0.1
FRONTEND_BIND_ADDRESS=127.0.0.1
MEDIA_HLS_BIND_ADDRESS=127.0.0.1
MEDIA_WEBRTC_BIND_ADDRESS=127.0.0.1

# RTMP publishing and WebRTC media need direct external ports.
MEDIA_RTMP_BIND_ADDRESS=0.0.0.0
MEDIA_WEBRTC_ICE_PORT=8189
